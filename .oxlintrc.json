{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "env": { "browser": true, "node": true, "es2024": true },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "**/.turbo/",
    "apps/desktop/.build/",
    "apps/desktop/.cache/",
    "apps/desktop/dist/",
    "apps/desktop/src/app/dist/",
    "apps/desktop/source/packages/proto/generated/",
    "apps/desktop/source/packages/redacted-protos/generated/"
  ]
}
